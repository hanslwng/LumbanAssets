# LGU Property Inventory Management System
# Git Ignore File

# Storage and cache
storage/*
!storage/.gitkeep
!storage/.htaccess
!storage/templates/
!storage/templates/rpcse/
!storage/templates/rpcse/README.md
!storage/templates/rpcse/archive/
!storage/templates/rpcse/archive/.gitkeep
storage/templates/rpcse/*.xlsx
storage/templates/rpcse/archive/*.xlsx
!storage/templates/rpcppe/
!storage/templates/rpcppe/README.md
!storage/templates/rpcppe/archive/
!storage/templates/rpcppe/archive/.gitkeep
storage/templates/rpcppe/*.xlsx
storage/templates/rpcppe/archive/*.xlsx

# Database settings: theme/config.php — keep secrets out of commits if customized for production.


# Logs
*.log

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Backup files
*.bak
*.backup
*.sql.gz

# Uploaded files (if any)
public/uploads/*
!public/uploads/.gitkeep

# Environment files
.env
.env.local
.env.production

# Composer (if used later)
vendor/
composer.lock
composer.phar

# Node modules (if used later)
node_modules/
package-lock.json

# Build files
dist/
build/
